# Cloudflare Pages headers. One rule per path pattern: if two rules set the same header, Cloudflare joins the values.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images and QR codes: cache 30 days. Use a new filename when you replace one.
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/qr/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS: always revalidate so edits show up immediately.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/thanks
  X-Robots-Tag: noindex
